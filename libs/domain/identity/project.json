{
  "name": "domain-identity",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domain/identity/src",
  "projectType": "library",
  "tags": ["scope:identity", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nrwl/js:tsc",
      "options": {
        "outputPath": "dist/libs/domain/identity",
        "main": "libs/domain/identity/src/index.ts",
        "tsConfig": "libs/domain/identity/tsconfig.json"
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "libs/domain/identity/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/domain/identity/**/*.ts"]
      }
    }
  }
}
